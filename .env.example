# 复制为 .env.local 后填入实际值

# ─── AI 推理（OpenAI 兼容协议，任选一家）───
# 注意：开源版不含 /api/interpret 等后端接口，下面这组配置只在你自己实现了接口后才会用到；
# 只想排盘、看命盘的话不用填。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── 或用其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── AI 接口限流与每日熔断（可选，不填则使用默认值）───
# REDIS_URL=redis://...               # 可选：配置后跨实例共享计数；未配置则自动退回内存限流
# AI_RATE_LIMIT_ENABLED=true          # 设为 false 可关闭限流
# AI_RATE_LIMIT_IP_PER_MIN=5          # 单 IP 每分钟最多请求次数
# AI_RATE_LIMIT_IP_PER_DAY=20         # 单 IP 每日（UTC+8 自然日）最多请求次数
# AI_RATE_LIMIT_GLOBAL_PER_DAY=200    # 全站每日（UTC+8 自然日）总请求熔断上限

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
